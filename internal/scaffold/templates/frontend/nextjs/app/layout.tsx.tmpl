import type { Metadata } from "next";
import "./globals.css";
[[ if eq .Auth "clerk" ]]
import { ClerkProvider } from "@clerk/nextjs";
[[ end ]]
[[ if eq .Auth "next-auth" ]]
import { SessionProvider } from "next-auth/react";
[[ end ]]
[[ if eq .API "trpc" ]]
import { TRPCReactProvider } from "@/trpc/provider";
[[ else if eq .API "orpc" ]]
import { ORPCReactProvider } from "@/orpc/provider";
[[ end ]]

export const metadata: Metadata = {
  title: "[[.ProjectName]] | Powered by Koko",
  description: "Modern fullstack application built with Turborepo and Koko-cli",
};

export default function RootLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
[[ if eq .Auth "clerk" ]]
    <ClerkProvider>
[[ end ]]
      <html lang="en">
        <body className="antialiased min-h-screen bg-[#09090b] text-[#fafafa]">
[[ if eq .Auth "next-auth" ]]
          <SessionProvider>
[[ end ]]
[[ if eq .API "trpc" ]]
            <TRPCReactProvider>
              {children}
            </TRPCReactProvider>
[[ else if eq .API "orpc" ]]
            <ORPCReactProvider>
              {children}
            </ORPCReactProvider>
[[ else ]]
            {children}
[[ end ]]
[[ if eq .Auth "next-auth" ]]
          </SessionProvider>
[[ end ]]
        </body>
      </html>
[[ if eq .Auth "clerk" ]]
    </ClerkProvider>
[[ end ]]
  );
}
