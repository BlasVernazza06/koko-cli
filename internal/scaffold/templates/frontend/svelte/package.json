{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "[[ version "@sveltejs/adapter-auto" ]]",
    "@sveltejs/kit": "[[ version "@sveltejs/kit" ]]",
    "@sveltejs/vite-plugin-svelte": "[[ version "@sveltejs/vite-plugin-svelte" ]]",
    "autoprefixer": "[[ version "autoprefixer" ]]",
    "postcss": "[[ version "postcss" ]]",
    "svelte": "[[ version "svelte" ]]",
    "svelte-check": "[[ version "svelte-check" ]]",
    "tailwindcss": "[[ version "tailwindcss" ]]",
    "typescript": "[[ version "typescript" ]]",
    "vite": "[[ version "vite" ]]"
  }
}
