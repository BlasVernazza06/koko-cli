import express from 'express';
import cors from 'cors';
[[ if eq .API "trpc" ]]
import { trpcMiddleware } from './trpc';
[[ else if eq .API "orpc" ]]
import { orpcMiddleware } from './orpc';
[[ end ]]
[[ if and (ne .Database "") (ne .Database "none") ]]
[[ if eq .ORM "prisma" ]]
import { prisma } from '@repo/db';
[[ else if eq .ORM "drizzle" ]]
import { db } from '@repo/db';
[[ else if eq .ORM "mongoose" ]]
import { connectDB } from '@repo/db';
[[ end ]]
[[ end ]]
[[ if eq .Auth "better-auth" ]]
import { auth } from '@repo/auth';
import { toNodeHandler } from 'better-auth/node';
[[ else if eq .Auth "clerk" ]]
import { clerkMiddleware } from '@clerk/express';
[[ end ]]

const app = express();
const port = process.env.PORT || 8080;

app.use(cors());
app.use(express.json());

[[ if eq .Auth "clerk" ]]
app.use(clerkMiddleware());
[[ end ]]

[[ if eq .Auth "better-auth" ]]
// Mount Better-Auth handler
app.all('/api/auth/*', toNodeHandler(auth));
[[ end ]]

[[ if eq .API "trpc" ]]
// Mount tRPC router middleware
app.use('/api/trpc', trpcMiddleware);
app.use('/trpc', trpcMiddleware);
[[ else if eq .API "orpc" ]]
// Mount oRPC router middleware
app.use('/api/orpc', orpcMiddleware);
app.use('/orpc', orpcMiddleware);
[[ end ]]

interface Todo {
  id: number;
  title: string;
  done: boolean;
}

let todos: Todo[] = [
  { id: 1, title: 'Aprender Node.js Express', done: false },
  { id: 2, title: 'Configurar Monorepo', done: true },
];

// Health Check
app.get('/api/health', (req, res) => {
  res.json({
    status: 'ok',
    project: '[[.ProjectName]]-backend',
  });
});

// 1. GET - Obtener todos los todos
app.get('/api/todos', (req, res) => {
  res.json(todos);
});

// 2. POST - Crear un nuevo todo
app.post('/api/todos', (req, res) => {
  const { title } = req.body;
  if (!title) {
    res.status(400).json({ error: 'Title is required' });
    return;
  }

  const newTodo: Todo = {
    id: todos.length + 1,
    title,
    done: false,
  };
  todos.push(newTodo);
  res.status(201).json(newTodo);
});

// 3. PUT - Actualizar un todo existente
app.put('/api/todos/:id', (req, res) => {
  const id = parseInt(req.params.id, 10);
  const { title, done } = req.body;

  const todoIndex = todos.findIndex((t) => t.id === id);
  if (todoIndex === -1) {
    res.status(404).json({ error: 'Todo not found' });
    return;
  }

  if (title !== undefined) todos[todoIndex].title = title;
  if (done !== undefined) todos[todoIndex].done = done;

  res.json(todos[todoIndex]);
});

// 4. DELETE - Eliminar un todo
app.delete('/api/todos/:id', (req, res) => {
  const id = parseInt(req.params.id, 10);
  const todoIndex = todos.findIndex((t) => t.id === id);
  if (todoIndex === -1) {
    res.status(404).json({ error: 'Todo not found' });
    return;
  }

  todos = todos.filter((t) => t.id !== id);
  res.json({ message: 'Todo deleted successfully' });
});

[[ if eq .ORM "mongoose" ]]
connectDB();
[[ end ]]

app.listen(port, () => {
  console.log(`Server is running on port ${port}`);
});
