{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "[[ version "cors" ]]",
    "dotenv": "[[ version "dotenv" ]]",
    "express": "[[ version "express" ]]",
    "zod": "[[ version "zod" ]]"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "[[ version "@types/cors" ]]",
    "@types/express": "[[ version "@types/express" ]]",
    "@types/node": "[[ version "@types/node" ]]",
    "ts-node-dev": "[[ version "ts-node-dev" ]]",
    "typescript": "[[ version "typescript" ]]"
  }
}
